root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.cmd]
end_of_line = crlf

[*.md]
# Кінцеві пробіли можуть бути частиною Markdown-перенесення рядка.
trim_trailing_whitespace = false

[*.csv]
# Пробіли в CSV – частина тестових даних.
trim_trailing_whitespace = false
